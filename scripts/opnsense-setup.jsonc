// OPNsense pre-test setup configuration for terraform-provider-opnsense
//
// Each entry is a POST request applied to the OPNsense API before acceptance
// tests run. Entries are applied in order. If any entry fails, the CI step
// fails immediately.
//
// To add a new pre-condition:
//   1. Find the relevant API endpoint (GET the resource first to see its shape)
//   2. Add an entry below with a clear "description", the "endpoint", and the
//      full "body" payload.
//   No changes to configure-opnsense.py are needed.
[
  // ── Kea ──────────────────────────────────────────────────────────────────
  {
    "description": "Kea DHCPv4: register lan interface in general settings",
    "endpoint": "/api/kea/dhcpv4/set",
    "body": {
      "dhcpv4": {
        "general": {
          "enabled": "0",
          "interfaces": "lan",
          "valid_lifetime": "4000",
          "fwrules": "1"
        }
      }
    }
  },
  {
    "description": "Kea DHCPv6: register lan interface in general settings",
    "endpoint": "/api/kea/dhcpv6/set",
    "body": {
      "dhcpv6": {
        "general": {
          "enabled": "0",
          "interfaces": "lan",
          "valid_lifetime": "4000",
          "fwrules": "1"
        }
      }
    }
  },
  // ── Routing ───────────────────────────────────────────────────────────────
  {
    "description": "Routing: create a deterministic IPv4 gateway for static-route tests",
    "endpoint": "/api/routing/settings/addGateway",
    "body": {
      "gateway_item": {
        "disabled": "0",
        "name": "CI_GATEWAY",
        "descr": "Acceptance-test gateway",
        "interface": "lan",
        "ipprotocol": "inet",
        "gateway": "10.0.2.2",
        "defaultgw": "0",
        "fargw": "0",
        "monitor_disable": "1",
        "priority": "255",
        "weight": "1"
      }
    }
  },
  {
    "description": "Routing: apply gateway configuration",
    "endpoint": "/api/routing/settings/reconfigure",
    "body": {}
  }
]
